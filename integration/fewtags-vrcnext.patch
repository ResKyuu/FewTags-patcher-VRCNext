+// FewTags entries use Unity rich text. Only translate a small, safe subset to HTML;
+// escape all text and leave unsupported markup visible as text.
+function fewTagsRichTextHtml(value) {
+    const source = String(value || '');
+    const tokenRe = /<color=#[0-9a-f]{3,8}>|<\/color>|<b>|<\/b>|<i>|<\/i>|<size=\d+>|<\/size>|<br\s*\/?\s*>/gi;
+    const stack = [];
+    let html = '';
+    let last = 0;
+    let match;
+    while ((match = tokenRe.exec(source)) !== null) {
+        html += esc(source.slice(last, match.index));
+        const token = match[0];
+        const lower = token.toLowerCase();
+        if (lower.startsWith('<color=')) {
+            const color = lower.match(/^<color=(#[0-9a-f]{3,8})>$/)?.[1];
+            if (color) { html += `<span style="color:${color}">`; stack.push(['color', '</span>']); }
+        } else if (lower === '<b>') {
+            html += '<strong>'; stack.push(['b', '</strong>']);
+        } else if (lower === '<i>') {

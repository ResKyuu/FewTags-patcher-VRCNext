+using System.Net;
+using System.Net.Http.Headers;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+
+namespace VRCNext.Services;
+
+/// <summary>
+/// Reads the bundled FewTags databases and refreshes cached copies from the upstream repository.
+/// </summary>
+internal static class FewTagsService
+{
+    private sealed record Entry(IReadOnlyList<string> Labels, bool MarkedMalicious);
+
+    private const string FeedBase = "https://raw.githubusercontent.com/Fewdys/FewTags/main/";
+    private const int MaxDatabaseBytes = 32 * 1024 * 1024;
+    private static readonly string[] DatabaseFiles = ["FewTagsv2.json", "FewTags.json"];
+    private static readonly string CacheDirectory = Path.Combine(
+        Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData), "VRCNext", "FewTags");
+    private static readonly string StatePath = Path.Combine(CacheDirectory, "refresh-state.json");
+    private static readonly HttpClient Http = CreateHttpClient();
+    private static readonly SemaphoreSlim RefreshGate = new(1, 1);
+    private static IReadOnlyDictionary<string, Entry> _entries = Load();
+    private static int _autoRefreshStarted;
+
+    public static object? GetTags(string userId)
+    {
+        var entries = Volatile.Read(ref _entries);
+        if (string.IsNullOrWhiteSpace(userId) || !entries.TryGetValue(userId, out var entry))
+            return null;
+
+        return new { labels = entry.Labels, markedMalicious = entry.MarkedMalicious };
+    }
+
+    /// <summary>Starts a background refresh immediately, then checks upstream every six hours.</summary>
+    public static void StartAutoRefresh()
+    {
+        if (Interlocked.Exchange(ref _autoRefreshStarted, 1) != 0) return;
+        _ = Task.Run(async () =>
+        {
+            while (true)
+            {
+                try { await RefreshAsync().ConfigureAwait(false); }
+                catch (Exception ex) { CrashHandler.WriteEntry("FewTags.Refresh", ex); }
+                await Task.Delay(TimeSpan.FromHours(6)).ConfigureAwait(false);
+            }
+        });
+    }
+
+    private static async Task RefreshAsync()
+    {
+        await RefreshGate.WaitAsync().ConfigureAwait(false);
+        try
+        {
+            Directory.CreateDirectory(CacheDirectory);
+            var etags = ReadEtags();
+            var changed = false;
+
+            foreach (var fileName in DatabaseFiles)
+            {
+                try
+                {
+                    changed |= await RefreshFileAsync(fileName, etags).ConfigureAwait(false);
+                }
+                catch (Exception ex)
+                {
+                    // Keep the last known good cache (or bundled copy) when the network is unavailable.
+                    CrashHandler.WriteEntry($"FewTags.Refresh.{fileName}", ex);
+                }
+            }
+
+            SaveEtags(etags);
+            if (changed) Interlocked.Exchange(ref _entries, Load());
+        }
+        finally
+        {
+            RefreshGate.Release();
+        }
+    }
+
+    private static async Task<bool> RefreshFileAsync(string fileName, Dictionary<string, string> etags)
+    {
+        var cachePath = Path.Combine(CacheDirectory, fileName);
+        using var request = new HttpRequestMessage(HttpMethod.Get, FeedBase + fileName);
+        request.Headers.CacheControl = new CacheControlHeaderValue { NoCache = true };
+        if (File.Exists(cachePath) && etags.TryGetValue(fileName, out var etag) &&
+            EntityTagHeaderValue.TryParse(etag, out var parsedEtag))
+            request.Headers.IfNoneMatch.Add(parsedEtag);
+
+        using var response = await Http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead).ConfigureAwait(false);
+        if (response.StatusCode == HttpStatusCode.NotModified) return false;
+        response.EnsureSuccessStatusCode();
+
+        var bytes = await ReadLimitedAsync(response.Content).ConfigureAwait(false);
+        if (!IsValidDatabase(bytes))
+            throw new InvalidDataException($"The upstream {fileName} response was not a valid FewTags database.");
+
+        var temporaryPath = cachePath + ".download-" + Guid.NewGuid().ToString("N");
+        try
+        {
+            await File.WriteAllBytesAsync(temporaryPath, bytes).ConfigureAwait(false);
+            File.Move(temporaryPath, cachePath, overwrite: true);
+        }
+        finally
+        {
+            try { if (File.Exists(temporaryPath)) File.Delete(temporaryPath); } catch { }
+        }
+
+        if (response.Headers.ETag is { } newEtag)
+            etags[fileName] = newEtag.ToString();
+        else
+            etags.Remove(fileName);
+        return true;
+    }
+
+    private static async Task<byte[]> ReadLimitedAsync(HttpContent content)
+    {
+        if (content.Headers.ContentLength is > MaxDatabaseBytes)
+            throw new InvalidDataException("The FewTags database exceeded the download size limit.");
+
+        await using var input = await content.ReadAsStreamAsync().ConfigureAwait(false);
+        using var output = new MemoryStream();
+        var buffer = new byte[64 * 1024];
+        while (true)
+        {
+            var read = await input.ReadAsync(buffer).ConfigureAwait(false);
+            if (read == 0) break;
+            if (output.Length + read > MaxDatabaseBytes)
+                throw new InvalidDataException("The FewTags database exceeded the download size limit.");
+            output.Write(buffer, 0, read);
+        }
+        return output.ToArray();
+    }
+
+    private static bool IsValidDatabase(byte[] bytes)
+    {
+        try
+        {
+            var root = JObject.Parse(System.Text.Encoding.UTF8.GetString(bytes));
+            if (root["records"] is not JArray records || records.Count == 0) return false;
+            return records.OfType<JObject>().Any(record =>
+                !string.IsNullOrWhiteSpace(record["UserID"]?.ToString()));
+        }
+        catch
+        {
+            return false;
+        }
+    }
+
+    private static Dictionary<string, string> ReadEtags()
+    {
+        try
+        {
+            if (File.Exists(StatePath))
+                return JsonConvert.DeserializeObject<Dictionary<string, string>>(File.ReadAllText(StatePath))
+                    ?? new Dictionary<string, string>(StringComparer.Ordinal);
+        }
+        catch { }
+        return new Dictionary<string, string>(StringComparer.Ordinal);
+    }
+
+    private static void SaveEtags(Dictionary<string, string> etags)
+    {
+        try
+        {
+            var temporaryPath = StatePath + ".tmp";
+            File.WriteAllText(temporaryPath, JsonConvert.SerializeObject(etags));
+            File.Move(temporaryPath, StatePath, overwrite: true);
+        }
+        catch { }
+    }
+
+    private static HttpClient CreateHttpClient()
+    {
+        var client = new HttpClient { Timeout = TimeSpan.FromSeconds(30) };
+        client.DefaultRequestHeaders.UserAgent.ParseAdd("VRCNext-FewTags/1.0");
+        return client;
+    }
+
+    private static IReadOnlyDictionary<string, Entry> Load()
+    {
+        var result = new Dictionary<string, Entry>(StringComparer.Ordinal);
+        var v2UserIds = new HashSet<string>(StringComparer.Ordinal);
+
+        // FewTagsv2 is the newer schema. Even an inactive v2 entry takes precedence over a
+        // legacy entry, so a removed tag is not accidentally restored from the older database.
+        foreach (var record in ReadRecords("FewTagsv2.json"))
+        {
+            var userId = record["UserID"]?.ToString();
+            if (string.IsNullOrWhiteSpace(userId)) continue;
+            v2UserIds.Add(userId);
+            if (record["Active"]?.Value<bool>() != true) continue;
+
+            var labels = new List<string>();
+            AddIfActive(labels, record, "PlateText", "TextActive");
+            AddIfActive(labels, record, "PlateText2", "Text2Active");
+            AddIfActive(labels, record, "PlateText3", "Text3Active");
+            AddIfActive(labels, record, "PlateBigText", "BigTextActive");
+            var markedMalicious = record["Malicious"]?.Value<bool>() == true;
+            if (labels.Count == 0 && !markedMalicious) continue;
+
+            result[userId] = new Entry(labels, markedMalicious);
+        }
+
+        // The legacy database contains IDs not migrated to v2 and uses Tag[] plus TextActive.
+        foreach (var record in ReadRecords("FewTags.json"))
+        {
+            var userId = record["UserID"]?.ToString();
+            if (string.IsNullOrWhiteSpace(userId) || v2UserIds.Contains(userId)) continue;
+            if (record["Active"]?.Value<bool>() != true) continue;
+
+            var labels = new List<string>();
+            if (record["TextActive"]?.Value<bool>() == true && record["Tag"] is JArray tags)
+            {
+                foreach (var tag in tags)
+                {
+                    var text = tag.ToString().Trim();
+                    if (!string.IsNullOrEmpty(text)) labels.Add(text);
+                }
+            }
+            AddIfActive(labels, record, "PlateBigText", "BigTextActive");
+
+            var markedMalicious = record["Malicious"]?.Value<bool>() == true;
+            if (labels.Count == 0 && !markedMalicious) continue;
+            result[userId] = new Entry(labels, markedMalicious);
+        }
+
+        return result;
+    }
+
+    private static IEnumerable<JObject> ReadRecords(string fileName)
+    {
+        var candidates = new[]
+        {
+            Path.Combine(CacheDirectory, fileName),
+            Path.Combine(AppContext.BaseDirectory, fileName),
+        };
+        foreach (var path in candidates)
+        {
+            try
+            {
+                if (!File.Exists(path)) continue;
+                var records = JObject.Parse(File.ReadAllText(path))["records"] as JArray;
+                if (records is { Count: > 0 }) return records.OfType<JObject>().ToArray();
+            }
+            catch
+            {
+                // If the writable cache is corrupt, fall back to the bundled database.
+            }
+        }
+        return Array.Empty<JObject>();
+    }
+
+    private static void AddIfActive(List<string> labels, JObject record, string textField, string activeField)
+    {
+        if (record[activeField]?.Value<bool>() != true) return;
+        var text = record[textField]?.ToString()?.Trim();
+        if (!string.IsNullOrEmpty(text)) labels.Add(text);
+    }
+}
